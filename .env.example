# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://vicecityfiles.com

# ── Headless WordPress (WPGraphQL) ──────────────────────
WORDPRESS_GRAPHQL_ENDPOINT=https://cms.vicecityfiles.com/graphql
WORDPRESS_HOSTNAME=cms.vicecityfiles.com
WORDPRESS_AUTH_REFRESH_TOKEN=

# ── WooCommerce (WooGraphQL / REST) ─────────────────────
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ── Stripe ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Cloudinary ──────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mapbox ──────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Revalidation ────────────────────────────────────────
REVALIDATION_SECRET=change-me

# ── Google Tag Manager ──────────────────────────────────
NEXT_PUBLIC_GTM_ID=

# ── Newsletter (SMTP — defaults target Titan Email / Hostinger) ─
# Only SMTP_USER and SMTP_PASS are required; until they are set the
# signup form tells visitors "Signups open soon".
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: defaults to "Vice City Files <SMTP_USER>" and SMTP_USER
NEWSLETTER_FROM=
NEWSLETTER_NOTIFY_TO=

# ── Store ───────────────────────────────────────────────
# Optional ISO currency override (e.g. CAD). By default the currency is read
# from WooCommerce's formatted prices ($ → USD, € → EUR, £ → GBP, ₺ → TRY).
STORE_CURRENCY=
